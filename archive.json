          "comments": [
            {
              "originalPosition": 775,
              "body": "Proposal:\r\nThe scope is limited to connections between two endpoints. A third party that would contribute secret keying material, authenticate endpoint identities, or receive connection keys would change the trust model and require separate security and privacy analysis. One of the goals will those be to propose a solution that allows two endpoints to communicate but would prevent a third party to explicitly or implicitly also join the communication.",
              "createdAt": "2026-09-09T14:45:00Z",
              "updatedAt": "2026-09-09T14:45:01Z"
            }
